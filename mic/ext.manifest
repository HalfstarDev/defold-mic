name: "Mic"

platforms:
    ios:
        context:
            flags: ["-x", "objective-c++"]
            frameworks: ["AVFoundation", "AudioToolbox", "Foundation"]
            linkFlags: ["-ObjC"]

    arm64-ios:
        context:
            flags: ["-x", "objective-c++"]
            frameworks: ["AVFoundation", "AudioToolbox", "Foundation"]
            linkFlags: ["-ObjC"]

    x86_64-ios:
        context:
            flags: ["-x", "objective-c++"]
            frameworks: ["AVFoundation", "AudioToolbox", "Foundation"]
            linkFlags: ["-ObjC"]
